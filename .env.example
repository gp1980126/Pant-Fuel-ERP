# StationMitra / PumpPro environment template.
# Copy this file to `.env.local` for local dev, or set the same names in
# Vercel Project Settings -> Environment Variables (see VERCEL_DEPLOY.md).
# Never use service_role/secret keys here — the browser anon/publishable key ONLY.

# --- Supabase cloud (required for cloud login) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# --- Station identity ---
VITE_PUMPPRO_STATION_ID=SATAT-FILLING-STATION
VITE_PUMPPRO_PUMP_NAME=SATAT FILLING STATION

# --- Tenant identity (white-label; used on login screen, bills, reports) ---
VITE_PUMPPRO_ADDR=Bye Pass Road, Your City - 263139, Distt. Your District (Your State)
VITE_PUMPPRO_GSTIN=05XXXXXXXXXXX1Z4
VITE_PUMPPRO_STATE_CODE=05
VITE_PUMPPRO_DEALER_LINE=DEALER - YOUR OIL COMPANY LTD.
VITE_PUMPPRO_JURISDICTION=Your City
VITE_PUMPPRO_SUPPLIER=YOUR OIL COMPANY LTD.

# --- Commercial runtime ---
VITE_PUMPPRO_COMMERCIAL_MODE=true
# true  = login is BLOCKED if Supabase env is missing (recommended for production)
# false = fall back to local browser-only login (dev/isolated use only)
VITE_PUMPPRO_CLOUD_REQUIRED=true
